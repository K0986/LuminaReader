# Normalise line endings in the repository, and check them out correctly per platform.
* text=auto eol=lf

# cmd.exe does not reliably resolve `goto` labels in a batch file with LF endings, so
# the Windows launcher must be checked out with CRLF.
*.bat text eol=crlf

# Binary files git must not touch.
*.jar binary
*.pdf binary
*.png binary
*.webp binary
*.keystore binary
*.jks binary
